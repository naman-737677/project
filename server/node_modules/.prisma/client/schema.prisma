datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
}

enum ChatType {
  DIRECT // 1-on-1 cloud chat
  GROUP // Group chat
  CHANNEL // Broadcast channel
  SECRET // End-to-end encrypted direct chat
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  SYSTEM
}

enum SecretChatState {
  REQUESTED
  ACCEPTED
  DECLINED
  TERMINATED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String  @unique @db.VarChar(32)
  phone        String? @unique @db.VarChar(20)
  email        String? @unique @db.VarChar(255)
  passwordHash String  @db.VarChar(255)
  displayName  String  @db.VarChar(64)
  avatarUrl    String? @db.VarChar(512)
  bio          String? @db.VarChar(160)

  // Public Identity Key for E2EE Diffie-Hellman Initial Handshake
  identityKey String? @db.Text

  status     UserStatus @default(OFFLINE)
  lastSeenAt DateTime   @default(now()) @db.Timestamptz
  createdAt  DateTime   @default(now()) @db.Timestamptz
  updatedAt  DateTime   @updatedAt @db.Timestamptz

  // Relations
  sessions         DeviceSession[]
  participants     ChatParticipant[]
  sentMessages     Message[]           @relation("SentMessages")
  initiatedSecrets SecretChatSession[] @relation("SecretInitiator")
  receivedSecrets  SecretChatSession[] @relation("SecretRecipient")

  @@index([username])
  @@index([phone])
}

model DeviceSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  deviceId         String   @db.VarChar(128)
  deviceName       String   @db.VarChar(128)
  pushToken        String?  @db.VarChar(512)
  refreshTokenHash String   @db.VarChar(255)
  lastActiveAt     DateTime @default(now()) @db.Timestamptz
  createdAt        DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model Chat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ChatType @default(DIRECT)
  title     String?  @db.VarChar(128)
  avatarUrl String?  @db.VarChar(512)

  // Monotonically increasing sequence tracker for message ordering
  currentSeqId BigInt @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  participants  ChatParticipant[]
  messages      Message[]
  secretSession SecretChatSession?

  @@index([type])
  @@index([updatedAt(sort: Desc)])
}

model ChatParticipant {
  chatId String          @db.Uuid
  userId String          @db.Uuid
  role   ParticipantRole @default(MEMBER)

  // High-throughput Read Watermark (Telegram style cursor)
  lastReadSeqId BigInt   @default(0)
  lastReadAt    DateTime @default(now()) @db.Timestamptz

  isMuted    Boolean  @default(false)
  isArchived Boolean  @default(false)
  joinedAt   DateTime @default(now()) @db.Timestamptz

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId, isArchived])
  @@index([chatId, lastReadSeqId])
}

model Message {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId   String  @db.Uuid
  senderId String? @db.Uuid

  seqId       BigInt
  clientMsgId String? @db.VarChar(64)

  type    MessageType @default(TEXT)
  content String?     @db.Text

  replyToId String?   @db.Uuid
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User?               @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  attachments MessageAttachment[]

  @@unique([chatId, seqId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([senderId])
}

model MessageAttachment {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId    String  @db.Uuid
  fileUrl      String  @db.VarChar(1024)
  thumbnailUrl String? @db.VarChar(1024)
  fileName     String  @db.VarChar(255)
  fileSize     BigInt
  mimeType     String  @db.VarChar(128)

  width    Int?
  height   Int?
  duration Int?

  createdAt DateTime @default(now()) @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model SecretChatSession {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId      String @unique @db.Uuid
  initiatorId String @db.Uuid
  recipientId String @db.Uuid

  state SecretChatState @default(REQUESTED)

  initiatorKey   String  @db.Text
  recipientKey   String? @db.Text
  keyFingerprint String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  chat      Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  initiator User @relation("SecretInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipient User @relation("SecretRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([initiatorId])
  @@index([recipientId])
}
