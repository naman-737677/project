PORT=4000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_db?schema=public"

# Redis Connection Strings
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Real-Time Gateway Options
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=10000
